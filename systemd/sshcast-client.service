[Unit]
Description=Sshcast Roaming SSH Agent Workstation Client
Documentation=https://github.com/theraphim/sshcast-client
After=graphical-session.target network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sshcast-client run
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes

[Install]
WantedBy=default.target
